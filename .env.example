# ==============================================================================
# CodeGuard AI — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8787
NODE_ENV=development

# Google Gemini AI Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration
# Optional for public repositories; required for private repositories & higher rate limits
GITHUB_TOKEN=

# Persistent Storage — PostgreSQL
# Example: postgresql://postgres:password@localhost:5432/codeguard
# If omitted or unreachable, CodeGuard falls back gracefully to its resilient local store.
DATABASE_URL=

# Security, Sessions & Encryption
# Used for JWT tenant authentication and AES-256-GCM encryption of stored credentials
JWT_SECRET=replace_with_a_secure_random_string_in_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8787,https://codeguard-lhs.onrender.com

# Timeouts & Request Limits
API_TIMEOUT_MS=60000
MAX_DIFF_CHARS=60000
